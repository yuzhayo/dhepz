#include <windows.h>

#include "resource.h"
#include "dhepz_version_generated.h"

// VERSIONINFO keeps the installed binary identifiable and gives the release
// workflow's version bump one source of truth.
//
// NOTE: this file must stay LF-only. It will embed UI JSON verbatim via RCDATA,
// and CRLF corrupts it.

// First ICON statement becomes the EXE icon in Explorer.
IDI_APP_ICON ICON "..\\assets\\app.ico"

// Settings is a required core screen, not a drop-in feature module.
IDR_UI_CORE_JSON RCDATA "..\\assets\\ui\\core.json"
IDR_UI_SETTINGS_JSON RCDATA "..\\assets\\ui\\screens\\settings.json"

1 VERSIONINFO
 FILEVERSION DHEPZ_VERSION_COMMA
 PRODUCTVERSION DHEPZ_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Yuzha\0"
            VALUE "FileDescription", "dhepz\0"
            /* No adjacent "\0" on these two: rc does not concatenate a
               macro-expanded string with a following literal, and doing so
               silently yields an empty value. rc null-terminates anyway. */
            VALUE "FileVersion", DHEPZ_FILE_VERSION_STRING
            VALUE "InternalName", "dhepz\0"
            VALUE "OriginalFilename", "dhepz.exe\0"
            VALUE "ProductName", "dhepz\0"
            VALUE "ProductVersion", DHEPZ_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

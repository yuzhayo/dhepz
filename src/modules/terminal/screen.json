{
  "components": [
    {
      "type": "screen",
      "route_id": "terminal",
      "module_id": "terminal",
      "tab_label": "Terminal",
      "show_in_tabs": false,
      "children": [
        {
          "type": "container",
          "direction": "column",
          "gap": 10,
          "padding": { "left": 24, "top": 20, "right": 24, "bottom": 20 },
          "children": [
            { "type": "text", "text": "Quick Actions", "variant": "title", "align": "center" },
            {
              "type": "container",
              "direction": "row",
              "gap": 8,
              "children": [
                { "type": "input", "id": "working-folder", "width": 325, "value_binding": "working_folder", "suggestions_binding": "recent_folders", "placeholder": "Folder path" },
                { "type": "button", "id": "browse-folder", "width": 48, "label": "...", "action": "terminal:browse-folder", "action_payload": { "initial_folder": { "$bind": "working_folder" } } }
              ]
            },
            { "type": "toggle", "id": "venv-toggle", "label": "Check / install virtual environment", "checked_binding": "venv_enabled" },
            { "type": "button", "id": "launch-powershell-admin", "height": 46, "label": "PowerShell Admin", "enabled": { "$bind": "launch_enabled" }, "action": "terminal:launch", "action_payload": { "target": "powershell_admin", "working_folder": { "$bind": "working_folder" }, "venv_enabled": { "$bind": "venv_enabled" } } },
            { "type": "button", "id": "launch-powershell", "height": 46, "label": "PowerShell", "enabled": { "$bind": "launch_enabled" }, "action": "terminal:launch", "action_payload": { "target": "powershell", "working_folder": { "$bind": "working_folder" }, "venv_enabled": { "$bind": "venv_enabled" } } },
            {
              "type": "container",
              "direction": "row",
              "gap": 8,
              "children": [
                { "type": "combo", "id": "wsl-distro", "width": 325, "items_binding": "wsl_distros", "selected_value_binding": "wsl_distro", "placeholder": "WSL distro" },
                { "type": "button", "id": "refresh-wsl", "width": 48, "label": "R", "action": "terminal:refresh-wsl", "action_payload": {} }
              ]
            },
            { "type": "button", "id": "launch-wsl", "height": 46, "label": "WSL", "enabled": { "$bind": "launch_enabled" }, "action": "terminal:launch", "action_payload": { "target": "wsl", "wsl_distro": { "$bind": "wsl_distro" }, "working_folder": { "$bind": "working_folder" }, "venv_enabled": { "$bind": "venv_enabled" } } },
            { "type": "text", "text": { "$bind": "status" }, "variant": "caption", "align": "center" }
          ]
        }
      ]
    }
  ]
}
